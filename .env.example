# =============================================================================
# Smart Crop Assistant — Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to Git.
# =============================================================================

# Application
APP_NAME=smart-crop-assistant
APP_ENV=development
APP_DEBUG=true

# Backend Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Database (SQLite for development, PostgreSQL for production)
DATABASE_URL=sqlite:///./smart_crop.db
# DATABASE_URL=postgresql://user:password@localhost:5432/smart_crop_db

# ML Model Paths
CROP_MODEL_PATH=backend/app/ml/artifacts/crop_model.joblib
CROP_SCALER_PATH=backend/app/ml/artifacts/scaler.joblib

# CORS (Frontend URL)
CORS_ORIGINS=http://localhost:5173

# Future: Authentication
# SECRET_KEY=your-secret-key-here
# ACCESS_TOKEN_EXPIRE_MINUTES=30
